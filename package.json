{
  "name": "ameow",
  "private": true,
  "description": "Ameow desktop collector for files, images, and web video.",
  "version": "0.3.1",
  "author": "Wutpeach",
  "type": "module",
  "main": "dist-electron/electron/main.mjs",
  "scripts": {
    "predev": "node ./scripts/dev-preflight.mjs",
    "dev": "node ./scripts/run-electron-dev.mjs",
    "dev:renderer": "vite",
    "dev:lab": "vite --config vite.lab.config.ts",
    "preelectron:dev": "node ./scripts/dev-preflight.mjs",
    "electron:dev": "node ./scripts/run-electron-dev.mjs",
    "electron:build": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json",
    "version:set": "node ./scripts/update-version.mjs",
    "capabilities:seed": "node ./scripts/generate-capabilities-seed.mjs",
    "capabilities:probe": "npm run electron:build && tsc -p tsconfig.scripts.json && node ./dist-scripts/scripts/run-capability-probes.js",
    "capabilities:probe:review": "tsc -p tsconfig.scripts.json && node ./dist-scripts/scripts/generate-capability-probe-review.js",
    "telemetry:report": "tsc -p tsconfig.scripts.json && node ./dist-scripts/scripts/generate-download-telemetry-report.js",
    "docs:dev": "npm --prefix site run dev",
    "docs:build": "npm --prefix site run build",
    "docs:preview": "npm --prefix site run preview",
    "locales:sync": "node ./scripts/sync-locales.mjs",
    "prebuild": "npm run locales:sync",
    "build:renderer": "tsc && vite build",
    "build": "npm run build:renderer && npm run electron:build",
    "runtime:smoke:python": "node ./scripts/smoke-python-runtime.mjs",
    "runtime:smoke:downloaders": "npm run electron:build && node ./scripts/smoke-managed-python-downloaders.mjs",
    "runtime:verify:macos-package": "node ./scripts/verify-macos-python-runtime-package.mjs",
    "runtime:ensure:python": "node ./scripts/ensure-python-runtime.mjs",
    "package": "node ./scripts/run-electron-package.mjs",
    "package:dir": "node ./scripts/run-electron-package.mjs --dir",
    "package:win": "node ./scripts/run-electron-package.mjs --win nsis --x64",
    "package:win:dir": "node ./scripts/run-electron-package.mjs --win --x64 --dir",
    "package:mac:zip": "node ./scripts/run-electron-package.mjs --mac zip",
    "package:browser-extension": "node ./scripts/package-browser-extension.mjs",
    "package:macos-open-source-dmg": "node ./scripts/package-macos-open-source-dmg.mjs",
    "lint": "eslint src vite.config.ts --ext .ts,.tsx",
    "type-check": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview",
    "package:portable": "powershell -ExecutionPolicy Bypass -File ./scripts/package-portable.ps1",
    "package:portable:skip-build": "powershell -ExecutionPolicy Bypass -File ./scripts/package-portable.ps1 -SkipBuild"
  },
  "dependencies": {
    "image-max-url": "^2026.2.0",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "agentation": "3.0.2",
    "autoprefixer": "^10.4.23",
    "clsx": "^2.1.1",
    "electron": "^41.0.4",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.6.3",
    "motion": "^12.35.2",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.2.3",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  }
}
